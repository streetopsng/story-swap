# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Brevo (Sendinblue) Email API Configuration
VITE_BREVO_API_KEY=your_brevo_api_key_here
VITE_BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
VITE_BREVO_SENDER_NAME=Story Swap


